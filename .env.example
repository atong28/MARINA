# ─────────────────────────────────────────────────────────────────────────────
# MARINA – root environment file
#
# Copy to .env and fill in the required values:
#   cp .env.example .env
#
# Then start the full stack:
#   ./start.sh
# ─────────────────────────────────────────────────────────────────────────────

# Path to your model data directory (absolute or relative to repo root).
# Default when unset: ./checkpoints
# Must contain models.json and one subdirectory per model (e.g. marina_best/).
# MODEL_DATA_DIR=./checkpoints

# Absolute path to the MARINA project root (the directory that contains src/).
# Defaults to the repository root (.) when left unset.
# MARINA_PROJECT_ROOT=.


# ── Ports ─────────────────────────────────────────────────────────────────────

# Host port exposed by the nginx reverse proxy. Default: 8643
# The frontend and backend are not exposed directly; all traffic flows through nginx.
# NGINX_PORT=8643

# Toggle the interactive API documentation at the root nginx proxy.
# false (default): /docs, /redoc and /openapi.json are not routed to the backend.
# true: they are routed, and the frontend shows an "API Docs" header link.
#
# /api/* is routed either way. The frontend is a client-side SPA that calls
# /api/* from the browser through this proxy, so blocking those routes would
# disable predictions and search rather than hide an API. To keep the API itself
# non-public, put authentication in front of the whole site.
# EXPOSE_API_VIA_NGINX=false


# ── Inference device ──────────────────────────────────────────────────────────

# "cpu" (default) | "cuda" | "cuda:0"
# DEVICE=cpu


# ── PyTorch wheel index ───────────────────────────────────────────────────────

# Wheel index used when building the backend Docker image.
# Defaults to CPU-only wheels for widest compatibility.
# CUDA 12.4: TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# CUDA 12.8: TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu


# ── Backend Docker image: older CPU / NumPy baseline ─────────────────────────

# Build-time only (requires `docker compose build` after changing).
# Set to true on hosts that fail with:
#   NumPy was built with baseline optimizations (X86_V2) but your machine doesn't support (X86_V2)
# Uses NumPy 1.26 + pandas 2.x wheels with a lower x86-64 baseline.
# LEGACY_NUMPY=false


# ── Scaling ───────────────────────────────────────────────────────────────────

# Uvicorn worker count inside the backend container. Default: 1
# Model copies in RAM = UVICORN_WORKERS * (1 + MAX_COMPUTE_WORKERS).
# The in-process rate limiter is per worker, so limits scale with this too.
# UVICORN_WORKERS=1

# Compute pool workers for the predict endpoint. Default: 2
# MAX_COMPUTE_WORKERS=2

# Max pending jobs before the server returns 503. Default: 8
# MAX_COMPUTE_QUEUE=8


# ── Model selection ───────────────────────────────────────────────────────────

# Which models to preload at startup: "default", "all", or comma-separated IDs.
# PRELOAD_MODELS=default


# ── Rendering ─────────────────────────────────────────────────────────────────

# Similarity-map highlighting on result cards. Default: true
# Each highlighted card costs one leave-one-out fingerprint ablation per atom,
# which dominates card-building time on CPU. Set to false to serve plain
# depictions only; the UI then hides its "Similarity map" toggle.
# HIGHLIGHT_ENABLED=true
