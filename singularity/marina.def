Bootstrap: docker
From: nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

# MARINA training image for SDSC.
#
# Mirrors the pixi.toml environment. Conda package versions are pinned to the same
# ranges pixi resolves, so an image built months from now still matches the runs on
# Nautilus -- unpinned conda-forge would silently drift across numpy 2.x / pandas 3.x
# majors, which are both very new.
#
# TARGET GPU: this uses the cu128 torch wheel. If the target partition is Volta (V100,
# sm_70) verify the wheel actually carries sm_70 kernels before committing to it --
# see the arch check at the end of %post. To fall back, change TORCH_INDEX to
# https://download.pytorch.org/whl/cu126 and the base image to 12.6.x-cudnn-runtime.
#
# The code is NOT baked in; bind-mount the repo at runtime:
#   singularity exec --nv -B /path/to/MARINA:/code -B /path/to/data:/workspace \
#     marina.sif bash -c 'cd /code && torchrun --nproc_per_node 4 --module src.main marina ...'

%labels
    Author Anthony Tong
    Description MARINA / SMART-Moonshot training environment (micromamba, matches pixi.toml)

%help
    MARINA training environment
    - Python 3.13, CUDA 12.8 base, torch 2.8.0+cu128
    - conda-forge packages via micromamba, pinned to pixi.toml ranges
    - Bind the repo to /code and the dataset root to /workspace

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/conda/envs/smart/bin:$PATH
    export PYTHONUNBUFFERED=1
    # src.main is run with `--module`, so the repo root must be importable.
    export PYTHONPATH=/code:$PYTHONPATH

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive
    # Must be exported here, not only in %environment: %environment applies at runtime,
    # so without this the pip cache is baked into the image and inflates it by ~2 GB.
    export PIP_NO_CACHE_DIR=1
    export MAMBA_ROOT_PREFIX=/opt/micromamba
    export TORCH_INDEX=https://download.pytorch.org/whl/cu128

    apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl wget git bzip2 \
        build-essential pkg-config \
        libglib2.0-0 libxext6 libxrender1 libsm6 libx11-6 \
        libfontconfig1 libfreetype6 libstdc++6 \
        && rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/conda /opt/micromamba /code /workspace

    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
        | tar -xvj -C /tmp bin/micromamba
    mv /tmp/bin/micromamba /usr/local/bin/micromamba
    chmod +x /usr/local/bin/micromamba

    # Versions mirror pixi.toml [dependencies]. pydantic and torchmetrics are listed
    # explicitly because src/modules/*/args.py imports pydantic directly and the code
    # imports torchmetrics directly -- in the pixi env both arrive only transitively
    # (pydantic via wandb, torchmetrics via lightning), which is fragile.
    micromamba create -y -p /opt/conda/envs/smart -c conda-forge \
        "python>=3.13,<3.14" \
        "numpy>=2.4.2,<3" \
        "matplotlib>=3.10.8,<4" \
        "pandas>=3.0.1,<4" \
        "wandb>=0.25.0,<0.26" \
        "rdkit>=2025.9.6,<2026" \
        "pydantic>=2.12,<3" \
        "ipython>=9.10.0,<10" \
        "ipykernel>=7.2.0,<8" \
        "jupyter>=1.1.1,<2" \
        "tqdm>=4.67.3,<5" \
        "tyro>=1.0.8,<2" \
        "gdown>=5.2.1,<6" \
        "openpyxl>=3.1.5,<4" \
        "pyarrow>=23.0.1,<24" \
        "git-lfs>=3.7.1,<4" \
        pip

    /opt/conda/envs/smart/bin/pip install --upgrade pip setuptools wheel

    /opt/conda/envs/smart/bin/pip install \
        torch==2.8.0 --index-url "${TORCH_INDEX}"

    # lightning pulls pytorch_lightning and torchmetrics; both are imported directly
    # by the code, so they are asserted in the smoke test below rather than assumed.
    /opt/conda/envs/smart/bin/pip install \
        lightning==2.6.1 \
        torchmetrics \
        torch_geometric==2.7.0

    micromamba clean -a -y
    rm -rf /root/.cache/pip

    echo "=== smoke test: every module the MARINA source imports ==="
# heredoc body must start at column 0: the terminator has to be unindented, and the
# Python inside would otherwise be an IndentationError.
/opt/conda/envs/smart/bin/python - <<'PY'
import importlib, sys
mods = ["numpy", "matplotlib", "pandas", "pyarrow", "pydantic", "rdkit",
        "torch", "torchmetrics", "lightning", "pytorch_lightning",
        "tqdm", "tyro", "wandb", "torch_geometric"]
bad = []
for m in mods:
    try:
        mod = importlib.import_module(m)
        print(f"  {m:20s} {getattr(mod, '__version__', 'ok')}")
    except Exception as e:
        bad.append(f"{m}: {e}")
# The code does `from pydantic.dataclasses import dataclass`
from pydantic.dataclasses import dataclass  # noqa: F401
if bad:
    print("MISSING:", *bad, sep="\n  ")
    sys.exit(1)
print("all imports OK")
PY

    echo "=== torchrun present (pixi.toml drives training via torchrun --module) ==="
    /opt/conda/envs/smart/bin/torchrun --version || true

    echo "=== CUDA architectures baked into this torch wheel ==="
    # If the target partition is V100 (sm_70) and 7.0 is absent here, this image will
    # NOT run there -- rebuild against cu126 instead.
    /opt/conda/envs/smart/bin/python -c \
        "import torch; print('torch', torch.__version__); print('arch_list:', torch.cuda.get_arch_list())"

%runscript
    export PATH=/opt/conda/envs/smart/bin:$PATH
    exec "$@"

%test
    export PATH=/opt/conda/envs/smart/bin:$PATH
    python -c "import torch, rdkit, pydantic, lightning, tyro, pyarrow; print('image OK')"
