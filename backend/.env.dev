# ─────────────────────────────────────────────────────────────────────────────
# Dev-mode environment variables.
# Edit the paths below, then run:  make dev   (or source this file + uvicorn)
# ─────────────────────────────────────────────────────────────────────────────

# ── Paths (EDIT THESE) ────────────────────────────────────────────────────────
# Directory containing the MARINA src/ package (one level up from backend/).
MARINA_ROOT=..

# Directory containing model data (models.json + per-model subdirectories).
# Example: /data/nas-gpu/wang/atong/SMART-Moonshot/checkpoints/website
DATA_DIR=/data/nas-gpu/wang/atong/MARINA/checkpoints
MODEL_ROOT=/data/nas-gpu/wang/atong/MARINA/checkpoints/marina_best
DEFAULT_MODEL_ID=marina_best

# ── Dev settings (usually no need to change) ─────────────────────────────────
DEVICE=cuda
BACKEND_PORT=5050

# Disable the compute pool so predict runs inline (compatible with --reload).
MAX_COMPUTE_WORKERS=0

# DATASET_ROOT is required by src/modules/core/const.py.
# In dev mode it can point to the same place as DATA_DIR.
DATASET_ROOT=/data/nas-gpu/wang/atong/MARINA/checkpoints

KMP_DUPLICATE_LIB_OK=TRUE
PYTHONUNBUFFERED=1
