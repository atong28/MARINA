# ─────────────────────────────────────────────────────────────────────────────
# MARINA Backend – environment variables
#
# Docker usage:   cp .env.example .env   → edit → make up
# Dev usage:      cp .env.example .env.dev → edit → make dev
#
# See README.md for full documentation.
# ─────────────────────────────────────────────────────────────────────────────

# ── Inference device ──────────────────────────────────────────────────────────
# Use "cpu" for CPU-only inference (default).
# Set to "cuda" or "cuda:0" to enable GPU inference (requires GPU build).
DEVICE=cpu

# ── Docker build ──────────────────────────────────────────────────────────────
# PyTorch wheel index URL.  Change to a cu124/cu121 URL for GPU support.
# CPU (default):    https://download.pytorch.org/whl/cpu
# CUDA 12.4:        https://download.pytorch.org/whl/cu124
# CUDA 12.1:        https://download.pytorch.org/whl/cu121
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# When building the backend image: use NumPy 1.26 + pandas 2.x for older CPUs
# (no x86-64-v2). Same variable as root .env when using ../docker-compose.yml.
LEGACY_NUMPY=false

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
# Number of uvicorn worker processes (increase for higher throughput on multi-core)
UVICORN_WORKERS=2

# ── Paths ─────────────────────────────────────────────────────────────────────
# Directory containing model subdirectories and models.json.
MODEL_DATA_DIR=/path/to/model-data

# ── Compute pool ──────────────────────────────────────────────────────────────
# Worker processes for heavy inference (predict endpoint).
MAX_COMPUTE_WORKERS=2
# Maximum pending jobs before returning 503.
MAX_COMPUTE_QUEUE=8

# ── Model ─────────────────────────────────────────────────────────────────────
DEFAULT_MODEL_ID=marina_best
# Which models to preload at startup: "default", "all", or comma-separated ids.
PRELOAD_MODELS=default

# ── Rendering ─────────────────────────────────────────────────────────────────
# Similarity-map highlighting on result cards. Set to false to serve plain
# depictions only (skips a per-atom fingerprint ablation for every card).
HIGHLIGHT_ENABLED=true
